<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>partial</TrimMode>
    <PublishAot>true</PublishAot>
    <UseAppHost>true</UseAppHost>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Model files — standalone copies with namespace kept identical to Synqra.Tests
    so that BinarySerializationTests.cs requires no namespace changes.
  -->
  <ItemGroup>
    <Compile Include="..\..\Synqra.Utils\_Polyfill.cs" Link="_Polyfill.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Synqra.BinarySerializer\Synqra.BinarySerializer.csproj" />
    <ProjectReference Include="..\..\Synqra.Model\Synqra.Model.csproj" />
    <ProjectReference Include="..\..\Synqra.Utils\Synqra.Utils.csproj" />
    <ProjectReference Include="..\..\Synqra.CodeGeneration\Synqra.CodeGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Synqra.BinarySerializer.SourceGenerator\Synqra.BinarySerializer.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\Synqra.BinarySerializer.SourceGenerator\Synqra.BinarySerializer.SourceGenerator.targets" />

</Project>
