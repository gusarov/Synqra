<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <OutputItemType>Analyzer</OutputItemType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>$(CommonVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Synqra.Utils\_Polyfill.cs" Link="_Polyfill.cs" />
    <Compile Include="..\Synqra.CodeGeneration\CodeGenHelpers.cs" Link="CodeGenHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" IsVisible="false" Visibility="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Synqra.Utils\Synqra.Utils.csproj" OutputItemType="Analyzer" PrivateAssets="all" GeneratePathProperty="false" />
  </ItemGroup>

  <PropertyGroup>
    <GetTargetPathDependsOn>
      $(GetTargetPathDependsOn);_SbxSG_GetDependencyTargetPaths
    </GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="_SbxSG_GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)\Synqra.Utils.dll" IncludeRuntimeDependency="true" />
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)\Microsoft.Extensions.Logging.Abstractions.dll" IncludeRuntimeDependency="true" Condition="Exists('$(TargetDir)Microsoft.Extensions.Logging.Abstractions.dll')" />
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)\Microsoft.Extensions.DependencyInjection.Abstractions.dll" IncludeRuntimeDependency="true" Condition="Exists('$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll')" />
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)\System.Threading.AccessControl.dll" IncludeRuntimeDependency="true" Condition="Exists('$(TargetDir)System.Threading.AccessControl.dll')" />
    </ItemGroup>
  </Target>

</Project>
